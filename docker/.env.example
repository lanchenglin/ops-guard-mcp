# Copy to docker/.env and chmod 600.
# Never commit docker/.env.

OPS_GUARD_LOG_LEVEL=INFO

# At least 32 characters. Generate with: openssl rand -hex 32
OPS_GUARD_APPROVAL_SECRET=CHANGE_ME
OPS_GUARD_AGENT_SECRET_LOCAL=CHANGE_ME

# Dedicated Ops Guard Approval DingTalk enterprise app.
OPS_GUARD_DINGTALK_CLIENT_ID=ding_CHANGE_ME
OPS_GUARD_DINGTALK_CLIENT_SECRET=CHANGE_ME

# Add one variable per production remote Agent host as referenced by ops-guard.toml.
# OPS_GUARD_AGENT_SECRET_PROD_WEB_01=CHANGE_ME
