# Ops Guard MCP v0.2.2 - Docker Compose + standalone DingTalk Stream example
# Copy to docker/ops-guard.toml and replace all YOUR_* values.

[server]
state_dir = "/var/lib/ops-guard"
approval_base_url = "http://127.0.0.1:8765"
approval_link_secret_env = "OPS_GUARD_APPROVAL_SECRET"
request_ttl_seconds = 300
# First deployment: false. Enable only after approval-path smoke tests pass.
auto_execute_on_approval = false
bind_host = "127.0.0.1"
bind_port = 8765

[dingtalk]
enabled = true
mode = "interactive"
client_id_env = "OPS_GUARD_DINGTALK_CLIENT_ID"
client_secret_env = "OPS_GUARD_DINGTALK_CLIENT_SECRET"
card_template_id = "YOUR_DINGTALK_CARD_TEMPLATE_ID"
callback_owner = "ops_guard"
allowed_approver_user_ids = ["YOUR_APPROVER_USER_ID"]
require_context_sender_match = false
at_requester = true
default_conversation_type = "2"
default_sender_staff_id = "YOUR_PRIMARY_APPROVER_USER_ID"
default_sender_nick = "运维审批人"
default_conversation_id = "YOUR_APPROVAL_GROUP_CONVERSATION_ID"
timeout_seconds = 10

# Smoke-test target. local-agent is development-only.
[[hosts]]
id = "local-dev"
environment = "dev"
transport = "local-agent"
approve_sensitive_reads = false
allow_scripts = false
allowed_read_roots = ["/var/log", "/etc", "/tmp"]
allowed_workdirs = ["/tmp"]
default_workdir = "/tmp"
timeout_seconds = 30
max_output_bytes = 1048576
agent_secret_env = "OPS_GUARD_AGENT_SECRET_LOCAL"

# Production SSH example. Enable only after standalone approval tests pass.
